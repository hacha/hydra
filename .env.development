# VITE_HYDRA_SYNTH_URL is resolved in vite.config.js (sibling ../hydra-synth, else bundled /libs/hydra-synth.js). Set it here to override.
VITE_P5_URL=/libs/p5.min.js
VITE_VISION_BRIDGE_URL=/libs/vision-bridge.js
VITE_FONT_URL=/fonts/chivo.css
VITE_FAVICON_URL=/favicon.png
VITE_DEFAULT_WIDTH=1920
VITE_DEFAULT_HEIGHT=1080